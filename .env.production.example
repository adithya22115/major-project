# Copy to .env on the VPS. Never commit the populated .env file.
POSTGRES_DB=medicycle
POSTGRES_USER=medicycle
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

APP_BASE_URL=https://medicycle.example.com
APP_CORS_ALLOWED_ORIGINS=https://medicycle.example.com
# Host port for the frontend container. Keep 8080 when using Caddy/Nginx for HTTPS.
HTTP_PORT=8080

ADMIN_EMAIL=admin@medicycle.example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=MediCycle Admin
ADMIN_PHONE=0000000000

# Optional doctor seed account.
DOCTOR_EMAIL=
DOCTOR_PASSWORD=
DOCTOR_NAME=MediCycle Doctor

# Optional SMTP configuration. Configure this before enabling email workflows.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Optional OpenAI-compatible providers. Blank keys use the built-in fallback.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
MEDICINE_ANALYSIS_API_KEY=
MEDICINE_ANALYSIS_API_URL=https://api.openai.com/v1/chat/completions
MEDICINE_ANALYSIS_MODEL=gpt-4o-mini
